# --- Python / server ---
server/.venv/
__pycache__/
*.egg-info/
*.pyc

# --- Flutter / app ---
app/build/
app/.dart_tool/
app/android/.gradle/
app/linux/flutter/ephemeral/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# --- Media & archives (never commit music) ---
Music.tar.gz
*.tar.gz
Playlists/**/*.mp3
Playlists/**/*.lrc
Playlists/**/*.m4a
Playlists/**/*.flac
Playlists/**/*.opus
Playlists/**/*.ogg
Playlists/**/*.jpg
Playlists/**/*.png

# --- Release APKs: ignore stray APKs, but TRACK versioned NASMusic-*.apk ---
*.apk
!NASMusic-*.apk
.DS_Store
Thumbs.db

# --- Secrets / local deploy (never commit keys) ---
omv-compose.yml
*.env
*secret*
